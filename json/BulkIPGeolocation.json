    "schemas": {
      "ASInfo": {
        "type": "object",
        "description": "Autonomous System details. Available on the Security plan.",
        "properties": {
          "as_number": {
            "type": "string",
            "description": "Autonomous system number (ASN).",
            "example": "15169"
          },
          "as_name": {
            "type": "string",
            "description": "Autonomous system (AS) name.",
            "example": "Google LLC"
          },
          "as_domain": {
            "type": "string",
            "description": "Domain name of the AS registrant.",
            "example": "google.com"
          },
          "as_usage_type": {
            "type": "string",
            "enum": [
              "COM",
              "ORG",
              "GOV",
              "MIL",
              "EDU",
              "LIB",
              "CDN",
              "ISP",
              "MOB",
              "DCH",
              "SES",
              "AIC",
              "RSV",
              "ISP/MOB"
            ],
            "description": "Usage type of the AS registrant.",
            "example": "DCH"
          },
          "as_cidr": {
            "type": "string",
            "description": "CIDR range for the whole AS.",
            "example": "8.8.8.0/24"
          }
        }
      },
      "Continent": {
        "type": "object",
        "description": "Continent details. Available on the Plus and Security plans.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Continent name.",
            "example": "North America"
          },
          "code": {
            "type": "string",
            "enum": [
              "AF",
              "AN",
              "AS",
              "EU",
              "NA",
              "OC",
              "SA"
            ],
            "description": "Two-character continent code.",
            "example": "NA"
          },
          "hemisphere": {
            "type": "array",
            "description": "The hemisphere where the country is located. The first item is the north/south hemisphere and the second item is the east/west hemisphere.",
            "items": {
              "type": "string",
              "enum": [
                "north",
                "south",
                "east",
                "west"
              ]
            },
            "example": [
              "north",
              "west"
            ]
          },
          "translation": {
            "type": "object",
            "description": "Translation of the name for the language requested with the `lang` parameter. Both values are null when no translation is available, for example for city names.",
            "properties": {
              "lang": {
                "type": [
                  "string",
                  "null"
                ],
                "example": "ko"
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ],
                "example": "북아메리카"
              }
            }
          }
        }
      },
      "Country": {
        "type": "object",
        "description": "Country details. Available on the Plus and Security plans.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Country name based on ISO 3166.",
            "example": "United States of America"
          },
          "alpha3_code": {
            "type": "string",
            "description": "Three-character country code based on ISO 3166.",
            "example": "USA"
          },
          "numeric_code": {
            "type": [
              "integer",
              "string"
            ],
            "description": "ISO 3166-1 numeric country code. The single-IP API returns an integer; the Bulk API returns the same value as a numeric string.",
            "example": 840
          },
          "demonym": {
            "type": "string",
            "description": "Native of the country.",
            "example": "Americans"
          },
          "flag": {
            "type": "string",
            "format": "uri",
            "description": "URL of the country flag image.",
            "example": "https://cdn.ip2location.io/assets/img/flags/us.png"
          },
          "capital": {
            "type": "string",
            "description": "Capital of the country.",
            "example": "Washington, D.C."
          },
          "total_area": {
            "type": "number",
            "description": "Total area in square kilometres.",
            "example": 9826675
          },
          "population": {
            "type": "integer",
            "description": "Population of the country.",
            "example": 339665118
          },
          "currency": {
            "type": "object",
            "description": "Currency of the country.",
            "properties": {
              "code": {
                "type": "string",
                "description": "ISO 4217 currency code.",
                "example": "USD"
              },
              "name": {
                "type": "string",
                "description": "Currency name.",
                "example": "United States Dollar"
              },
              "symbol": {
                "type": "string",
                "description": "Currency symbol.",
                "example": "$"
              }
            }
          },
          "language": {
            "type": "object",
            "description": "Primary language of the country.",
            "properties": {
              "code": {
                "type": "string",
                "description": "Language code.",
                "example": "EN"
              },
              "name": {
                "type": "string",
                "description": "Language name.",
                "example": "English"
              }
            }
          },
          "tld": {
            "type": "string",
            "description": "Country-code top-level domain.",
            "example": "us"
          },
          "translation": {
            "type": "object",
            "description": "Translation of the name for the language requested with the `lang` parameter. Both values are null when no translation is available, for example for city names.",
            "properties": {
              "lang": {
                "type": [
                  "string",
                  "null"
                ],
                "example": "ko"
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ],
                "example": "북아메리카"
              }
            }
          }
        }
      },
      "Region": {
        "type": "object",
        "description": "Region details. Available on the Plus and Security plans.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Region or state name.",
            "example": "California"
          },
          "code": {
            "type": "string",
            "description": "ISO 3166-2 code.",
            "example": "US-CA"
          },
          "translation": {
            "type": "object",
            "description": "Translation of the name for the language requested with the `lang` parameter. Both values are null when no translation is available, for example for city names.",
            "properties": {
              "lang": {
                "type": [
                  "string",
                  "null"
                ],
                "example": "ko"
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ],
                "example": "북아메리카"
              }
            }
          }
        }
      },
      "City": {
        "type": "object",
        "description": "City details. Available on the Plus and Security plans.",
        "properties": {
          "name": {
            "type": "string",
            "description": "City name.",
            "example": "Mountain View"
          },
          "translation": {
            "type": "object",
            "description": "Translation of the name for the language requested with the `lang` parameter. Both values are null when no translation is available, for example for city names.",
            "properties": {
              "lang": {
                "type": [
                  "string",
                  "null"
                ],
                "example": "ko"
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ],
                "example": "북아메리카"
              }
            }
          }
        }
      },
      "TimeZoneInfo": {
        "type": "object",
        "description": "Detailed time zone information. Available on the Plus and Security plans.",
        "properties": {
          "olson": {
            "type": "string",
            "description": "Time zone in Olson format.",
            "example": "America/Los_Angeles"
          },
          "current_time": {
            "type": "string",
            "format": "date-time",
            "description": "Current local time in ISO 8601 format.",
            "example": "2025-11-16T12:00:00-08:00"
          },
          "gmt_offset": {
            "type": "integer",
            "description": "GMT offset in seconds.",
            "example": -28800
          },
          "is_dst": {
            "type": "boolean",
            "description": "Whether the time zone is currently observing daylight saving time.",
            "example": false
          },
          "abbreviation": {
            "type": "string",
            "description": "Time zone abbreviation, for example EST or PDT.",
            "example": "PST"
          },
          "dst_start_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Date on which daylight saving time starts, or null in a time zone without DST.",
            "example": "2026-03-08"
          },
          "dst_end_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Date on which daylight saving time ends, or null in a time zone without DST.",
            "example": "2026-11-01"
          },
          "sunrise": {
            "type": "string",
            "description": "Sunrise time in local time (hh:mm).",
            "example": "06:45"
          },
          "sunset": {
            "type": "string",
            "description": "Sunset time in local time (hh:mm).",
            "example": "16:55"
          }
        }
      },
      "Geotargeting": {
        "type": "object",
        "description": "Geotargeting data. Available on the Plus and Security plans.",
        "properties": {
          "metro": {
            "type": [
              "string",
              "null"
            ],
            "description": "Metro code based on the ZIP or postal code, or null when the address is outside a metered area.",
            "example": "807"
          }
        }
      },
      "Proxy": {
        "type": "object",
        "description": "Proxy and threat details. The full object is available on the Security plan; lower plans only return `is_proxy`.",
        "properties": {
          "last_seen": {
            "type": "integer",
            "description": "Number of days since the proxy was last seen.",
            "example": 13
          },
          "proxy_type": {
            "type": "string",
            "enum": [
              "VPN",
              "TOR",
              "DCH",
              "PUB",
              "WEB",
              "SES",
              "AIC",
              "RES",
              "CPN",
              "EPN"
            ],
            "description": "Type of proxy.",
            "example": "DCH"
          },
          "threat": {
            "type": "string",
            "description": "Security threats reported for the address as a slash-separated list: SPAM, SCANNER, BOTNET and BOGON. \"-\" when none apply.",
            "example": "-"
          },
          "provider": {
            "type": "string",
            "description": "Name of the VPN provider, when available.",
            "example": "-"
          },
          "is_vpn": {
            "type": "boolean",
            "description": "Anonymising VPN service.",
