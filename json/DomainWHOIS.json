{
  "openapi": "3.2.0",
  "info": {
    "title": "IP2WHOIS Domain WHOIS API",
    "summary": "Domain WHOIS",
    "description": "IP2WHOIS Domain WHOIS API returns registration and contact data for a domain name: creation, update and expiry dates, domain age, registrar, registrant, administrative, technical and billing contacts, nameservers and WHOIS server.\n\n**Authentication.** Send your API key as a Bearer token in the `Authorization` header (recommended), or as the `key` query parameter. This endpoint requires an API key.\n\n**Privacy.** Registries and privacy services often redact contact details. Fields are returned as published, and may be empty or replaced by a referral message. Treat missing values as redacted rather than invalid.\n\nThe endpoint supports JSON and XML responses.",
    "version": "1.0.0",
    "termsOfService": "https://www.ip2location.io/terms-of-service",
    "contact": {
      "name": "IP2Location.io",
      "url": "https://www.ip2location.io",
      "email": "support@ip2location.io"
    },
    "license": {
      "name": "MIT",
      "url": "https://github.com/ip2location/ip2location-io-openapi/blob/main/LICENSE"
    }
  },
  "servers": [
    {
      "url": "https://api.ip2whois.com/v2",
      "description": "IP2WHOIS endpoint."
    }
  ],
  "tags": [
    {
      "name": "Domain WHOIS",
      "description": "Look up registration and contact data for a domain name."
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Domain WHOIS"
        ],
        "summary": "Look up a domain WHOIS record",
        "description": "Returns the WHOIS record for a domain name. Contact fields may be redacted by the registry or a privacy service.",
        "operationId": "domainWHOIS",
        "externalDocs": {
          "description": "Domain WHOIS API documentation",
          "url": "https://www.ip2location.io/ip2whois-documentation"
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/key_required"
          },
          {
            "name": "domain",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "hostname",
              "example": "locaproxy.com"
            },
            "description": "Domain name to look up."
          },
          {
            "$ref": "#/components/parameters/format_json_xml"
          }
        ],
        "responses": {
          "200": {
            "description": "WHOIS record for the domain.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainWHOISResponse"
                },
                "examples": {
                  "Domain WHOIS": {
                    "value": {
                      "domain": "locaproxy.com",
                      "domain_id": "1710914405_DOMAIN_COM-VRSN",
                      "status": "clientTransferProhibited https://icann.org/epp#clientTransferProhibited",
                      "create_date": "2012-04-03T02:34:32Z",
                      "update_date": "2021-12-03T02:54:57Z",
                      "expire_date": "2027-04-03T07:34:32Z",
                      "domain_age": 5340,
                      "whois_server": "whois.godaddy.com",
                      "registrar": {
                        "iana_id": "146",
                        "name": "GoDaddy.com, LLC",
                        "url": "https://www.godaddy.com"
                      },
                      "registrant": {
                        "name": "Registration Private",
                        "organization": "Domains By Proxy, LLC",
                        "street_address": "DomainsByProxy.com",
                        "city": "Tempe",
                        "region": "Arizona",
                        "zip_code": "85284",
                        "country": "US",
                        "phone": "+1.4806242599",
                        "fax": "+1.4806242598",
                        "email": "Select Contact Domain Holder link at https://www.godaddy.com/whois/results.aspx?domain=LOCAPROXY.COM"
                      },
                      "admin": {
                        "name": "Registration Private",
                        "organization": "Domains By Proxy, LLC",
                        "street_address": "DomainsByProxy.com",
                        "city": "Tempe",
                        "region": "Arizona",
                        "zip_code": "85284",
                        "country": "US",
                        "phone": "+1.4806242599",
                        "fax": "+1.4806242598",
                        "email": "Select Contact Domain Holder link at https://www.godaddy.com/whois/results.aspx?domain=LOCAPROXY.COM"
                      },
                      "tech": {
                        "name": "Registration Private",
                        "organization": "Domains By Proxy, LLC",
                        "street_address": "DomainsByProxy.com",
                        "city": "Tempe",
                        "region": "Arizona",
                        "zip_code": "85284",
                        "country": "US",
                        "phone": "+1.4806242599",
                        "fax": "+1.4806242598",
                        "email": "Select Contact Domain Holder link at https://www.godaddy.com/whois/results.aspx?domain=LOCAPROXY.COM"
                      },
                      "billing": {
                        "name": "",
                        "organization": "",
                        "street_address": "",
                        "city": "",
                        "region": "",
                        "zip_code": "",
                        "country": "",
                        "phone": "",
                        "fax": "",
                        "email": ""
                      },
                      "nameservers": [
                        "vera.ns.cloudflare.com",
                        "walt.ns.cloudflare.com"
                      ]
                    }
                  }
                }
              },
              "application/xml": {
                "schema": {
                  "type": "string",
                  "description": "XML representation of the same fields as the JSON response, with a root `<result>` element."
                },
                "example": "<result>\n  <domain>locaproxy.com</domain>\n  <domain_id>1710914405_DOMAIN_COM-VRSN</domain_id>\n  <status>clientTransferProhibited https://icann.org/epp#clientTransferProhibited</status>\n  <create_date>2012-04-03T02:34:32Z</create_date>\n  <update_date>2021-12-03T02:54:57Z</update_date>\n  <expire_date>2027-04-03T07:34:32Z</expire_date>\n  <domain_age>5340</domain_age>\n  <whois_server>whois.godaddy.com</whois_server>\n  <nameservers>\n    <item>vera.ns.cloudflare.com</item>\n    <item>walt.ns.cloudflare.com</item>\n  </nameservers>\n</result>"
              }
            }
          },
          "400": {
            "description": "Missing parameter, invalid domain, or invalid format.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "Missing parameter": {
                    "value": {
                      "error": {
                        "error_code": 10000,
                        "error_message": "Missing parameter."
                      }
                    }
                  },
                  "Invalid domain": {
                    "value": {
                      "error": {
                        "error_code": 10007,
                        "error_message": "Invalid domain."
                      }
                    }
                  },
                  "Invalid format": {
                    "value": {
                      "error": {
                        "error_code": 10008,
                        "error_message": "Invalid format."
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "API key not found, disabled, expired, or out of queries.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "API key not found": {
                    "value": {
                      "error": {
                        "error_code": 10001,
                        "error_message": "API key not found."
                      }
                    }
                  },
                  "API key disabled": {
                    "value": {
                      "error": {
                        "error_code": 10002,
                        "error_message": "API key disabled."
                      }
                    }
                  },
                  "API key expired": {
                    "value": {
                      "error": {
                        "error_code": 10003,
                        "error_message": "API key expired."
                      }
                    }
                  },
                  "Insufficient queries": {
                    "value": {
                      "error": {
                        "error_code": 10004,
                        "error_message": "Insufficient queries."
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No WHOIS data found for the domain.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "No data found": {
                    "value": {
                      "error": {
                        "error_code": 10006,
                        "error_message": "No data found."
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unknown error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "Unknown error": {
                    "value": {
                      "error": {
                        "error_code": 10005,
                        "error_message": "Unknown error."
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKey": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key sent as `Authorization: Bearer {YOUR_API_KEY}`. This is the recommended method because it keeps the key out of URLs, logs and browser history."
      },
      "apiKey": {
        "type": "apiKey",
        "in": "query",
        "name": "key",
        "description": "API key sent as the `key` query parameter. Supported as an alternative to the Bearer token, but less secure because the key appears in the URL."
      }
    },
    "parameters": {
      "key_required": {
        "name": "key",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "API key. Optional when the key is sent as an `Authorization: Bearer` token. Get a free key at https://www.ip2location.io/sign-up."
      },
      "format_json_xml": {
        "name": "format",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "json",
            "xml"
          ],
          "default": "json"
        },
        "description": "Response format. Defaults to `json`."
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "description": "Error envelope returned for every failed request.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "error_code",
              "error_message"
            ],
            "properties": {
              "error_code": {
                "type": "integer",
                "description": "Numeric error code, unique within the API.",
                "example": 10001
              },
              "error_message": {
                "type": "string",
                "description": "Human-readable error message.",
                "example": "Invalid IP address."
              }
            }
          }
        }
      },
      "Contact": {
        "type": "object",
        "description": "WHOIS contact details. Fields are omitted or empty when the registry redacts them.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Contact name.",
            "example": "Registration Private"
          },
          "organization": {
            "type": "string",
            "description": "Contact organisation.",
            "example": "Domains By Proxy, LLC"
          },
          "street_address": {
            "type": "string",
            "description": "Street address.",
            "example": "DomainsByProxy.com"
          },
          "city": {
            "type": "string",
            "description": "City.",
            "example": "Tempe"
          },
          "region": {
            "type": "string",
            "description": "Region or state.",
            "example": "Arizona"
          },
          "zip_code": {
            "type": "string",
            "description": "ZIP or postal code.",
            "example": "85284"
          },
          "country": {
            "type": "string",
            "description": "Country code.",
            "example": "US"
          },
          "phone": {
            "type": "string",
            "description": "Phone number.",
            "example": "+1.4806242599"
          },
          "fax": {
            "type": "string",
            "description": "Fax number.",
            "example": "+1.4806242598"
          },
          "email": {
            "type": "string",
            "description": "Email address.",
            "example": "Select Contact Domain Holder link at https://www.godaddy.com/whois/results.aspx?domain=LOCAPROXY.COM"
          }
        }
      },
      "Registrar": {
        "type": "object",
        "description": "Registrar that sponsors the domain.",
        "properties": {
          "iana_id": {
            "type": "string",
            "description": "Registrar IANA ID.",
            "example": "146"
          },
          "name": {
            "type": "string",
            "description": "Registrar name.",
            "example": "GoDaddy.com, LLC"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Registrar website.",
            "example": "https://www.godaddy.com"
          }
        }
      },
      "DomainWHOISResponse": {
        "type": "object",
        "description": "WHOIS record for one domain.",
        "required": [
          "domain"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "description": "Domain name.",
            "example": "locaproxy.com"
          },
          "domain_id": {
            "type": "string",
            "description": "Domain name ID assigned by the registry.",
            "example": "1710914405_DOMAIN_COM-VRSN"
          },
          "status": {
            "type": "string",
            "description": "Domain status, including the EPP status code and its ICANN reference.",
            "example": "clientTransferProhibited https://icann.org/epp#clientTransferProhibited"
          },
          "create_date": {
            "type": "string",
            "format": "date-time",
            "description": "Domain creation date.",
            "example": "2012-04-03T02:34:32Z"
          },
          "update_date": {
            "type": "string",
            "format": "date-time",
            "description": "Date of the last domain update.",
            "example": "2021-12-03T02:54:57Z"
          },
          "expire_date": {
            "type": "string",
            "format": "date-time",
            "description": "Domain expiration date.",
            "example": "2027-04-03T07:34:32Z"
          },
          "domain_age": {
            "type": "integer",
            "description": "Domain age in days.",
            "example": 5340
          },
          "whois_server": {
            "type": "string",
            "description": "WHOIS server that answered the query.",
            "example": "whois.godaddy.com"
          },
          "registrar": {
            "$ref": "#/components/schemas/Registrar"
          },
          "registrant": {
            "$ref": "#/components/schemas/Contact"
          },
          "admin": {
            "$ref": "#/components/schemas/Contact"
          },
          "tech": {
            "$ref": "#/components/schemas/Contact"
          },
          "billing": {
            "$ref": "#/components/schemas/Contact"
          },
          "nameservers": {
            "type": "array",
            "description": "Nameservers configured for the domain.",
            "items": {
              "type": "string",
              "example": "vera.ns.cloudflare.com"
            },
            "example": [
              "vera.ns.cloudflare.com",
              "walt.ns.cloudflare.com"
            ]
          }
        }
      }
    }
  }
}
