{
  "openapi": "3.0.3",
  "info": {
    "title": "IP2WHOIS Domain WHOIS API",
    "description": "IP2WHOIS Domain WHOIS API helps users to obtain domain information and WHOIS record by using a domain name. The WHOIS API returns a comprehensive WHOIS data such as creation date, updated date, expiration date, domain age, the contact information of the registrant, mailing address, phone number, email address, nameservers the domain is using and much more.",
    "version": "1",
    "contact": {
		"name": "IP2Location.io",
		"url": "https://github.com/ip2location/ip2location-io-openapi"
	}
  },
  "servers": [
    {
      "url": "https://api.ip2whois.com/v2"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Domain WHOIS",
        "description": "Check WHOIS information for a particular domain",
        "operationId": "domainWHOIS",
        "parameters": [
          {
            "name": "key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "(required) IP2Location.io API key."
          },
          {
            "name": "domain",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "locaproxy.com"
            },
            "description": "(required) Domain name."
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "enum": [
                "json",
                "xml"
              ],
              "type": "string",
              "default": "json"
            },
            "description": "(optional) Format of the response message. Default is json."
          }
        ],
        "responses": {
          "200": {
            "description": "Get response from domain WHOIS",
