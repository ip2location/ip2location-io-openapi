            "description": "Primary language of the country.",
            "properties": {
              "code": {
                "type": "string",
                "description": "Language code.",
                "examples": [
                  "EN"
                ]
              },
              "name": {
                "type": "string",
                "description": "Language name.",
                "examples": [
                  "English"
                ]
              }
            }
          },
          "tld": {
            "type": "string",
            "description": "Country-code top-level domain.",
            "examples": [
              "us"
            ]
          },
          "translation": {
            "type": "object",
            "description": "Translation of the name for the language requested with the `lang` parameter. Both values are null when no translation is available, for example for city names.",
            "properties": {
              "lang": {
