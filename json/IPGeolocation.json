  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key sent as `Authorization: Bearer {YOUR_API_KEY}`. This is the recommended method because it keeps the key out of URLs, logs and browser history."
      },
      "apiKey": {
        "type": "apiKey",
        "in": "query",
        "name": "key",
        "description": "API key sent as the `key` query parameter. Supported as an alternative to the Bearer token, but less secure because the key appears in the URL."
      }
    },
    "parameters": {
      "key": {
        "name": "key",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "API key. Requests without a key are limited to 1,000 queries per day. Send the key as a Bearer token (recommended) or as this query parameter. Get a free key at https://www.ip2location.io/sign-up."
      },
      "ip_optional": {
        "name": "ip",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "format": "ip",
          "examples": [
            "8.8.8.8"
          ]
        },
        "description": "IPv4 or IPv6 address to look up. When omitted, the IP address of the requesting client is used."
      },
      "format_json_xml": {
        "name": "format",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "json",
            "xml"
          ],
          "default": "json"
        },
        "description": "Response format. Defaults to `json`."
      },
      "lang": {
        "name": "lang",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "ar",
            "cs",
            "da",
            "de",
            "en",
            "es",
            "et",
            "fi",
            "fr",
            "ga",
            "it",
            "ja",
            "ko",
            "ms",
            "nl",
            "pt",
            "ru",
            "sv",
            "tr",
            "vi",
            "zh-cn",
            "zh-tw"
          ]
        },
        "description": "Language for the translation of continent, country, region and city names, as an ISO 639-1 code. Only one language can be requested at a time. Available on the Plus and Security plans; Free and Starter plans return error 10004."
      }
    },
    "schemas": {
      "ASInfo": {
        "type": "object",
        "description": "Autonomous System details. Available on the Security plan.",
        "properties": {
          "as_number": {
            "type": "string",
            "description": "Autonomous system number (ASN).",
            "examples": [
              "15169"
            ]
          },
          "as_name": {
            "type": "string",
            "description": "Autonomous system (AS) name.",
            "examples": [
              "Google LLC"
            ]
          },
          "as_domain": {
            "type": "string",
            "description": "Domain name of the AS registrant.",
            "examples": [
              "google.com"
            ]
          },
          "as_usage_type": {
            "type": "string",
            "enum": [
              "COM",
              "ORG",
              "GOV",
              "MIL",
              "EDU",
              "LIB",
              "CDN",
              "ISP",
              "MOB",
              "DCH",
              "SES",
              "AIC",
              "RSV",
              "ISP/MOB"
            ],
            "description": "Usage type of the AS registrant.",
            "examples": [
              "DCH"
            ]
          },
          "as_cidr": {
            "type": "string",
            "description": "CIDR range for the whole AS.",
            "examples": [
              "8.8.8.0/24"
            ]
          }
        }
      },
      "Continent": {
        "type": "object",
        "description": "Continent details. Available on the Plus and Security plans.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Continent name.",
            "examples": [
              "North America"
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "AF",
              "AN",
              "AS",
              "EU",
              "NA",
              "OC",
              "SA"
            ],
            "description": "Two-character continent code.",
            "examples": [
              "NA"
            ]
          },
          "hemisphere": {
            "type": "array",
            "description": "The hemisphere where the country is located. The first item is the north/south hemisphere and the second item is the east/west hemisphere.",
            "items": {
              "type": "string",
              "enum": [
                "north",
                "south",
                "east",
                "west"
              ]
            },
            "examples": [
              [
                "north",
                "west"
              ]
            ]
          },
          "translation": {
            "type": "object",
            "description": "Translation of the name for the language requested with the `lang` parameter. Both values are null when no translation is available, for example for city names.",
            "properties": {
              "lang": {
                "type": [
                  "string",
                  "null"
                ],
                "examples": [
                  "ko"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ],
                "examples": [
                  "북아메리카"
                ]
              }
            }
          }
        }
      },
      "Country": {
        "type": "object",
        "description": "Country details. Available on the Plus and Security plans.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Country name based on ISO 3166.",
            "examples": [
              "United States of America"
            ]
          },
          "alpha3_code": {
            "type": "string",
            "description": "Three-character country code based on ISO 3166.",
            "examples": [
              "USA"
            ]
          },
          "numeric_code": {
            "type": "integer",
            "description": "ISO 3166-1 numeric country code.",
            "examples": [
              840
            ]
          },
          "demonym": {
            "type": "string",
            "description": "Native of the country.",
            "examples": [
              "Americans"
            ]
          },
          "flag": {
            "type": "string",
            "format": "uri",
            "description": "URL of the country flag image.",
            "examples": [
              "https://cdn.ip2location.io/assets/img/flags/us.png"
            ]
          },
          "capital": {
            "type": "string",
            "description": "Capital of the country.",
            "examples": [
              "Washington, D.C."
            ]
          },
          "total_area": {
            "type": "number",
            "description": "Total area in square kilometres.",
            "examples": [
              9826675
            ]
          },
          "population": {
            "type": "integer",
            "description": "Population of the country.",
            "examples": [
              339665118
            ]
          },
          "currency": {
            "type": "object",
            "description": "Currency of the country.",
            "properties": {
              "code": {
                "type": "string",
                "description": "ISO 4217 currency code.",
                "examples": [
                  "USD"
                ]
              },
              "name": {
                "type": "string",
